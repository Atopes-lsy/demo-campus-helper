# ============================================
# 校园帮手 Campus Helper - 环境变量配置
# ============================================
# 使用方法: 复制此文件为 .env 并修改配置
#   copy .env.example .env
# ============================================

# --- MySQL 配置 ---
MYSQL_ROOT_PASSWORD=CampusHelper@2026!
MYSQL_DATABASE=campus_helper
DB_USERNAME=root
DB_PASSWORD=CampusHelper@2026!

# --- DeepSeek AI 配置 ---
# 获取 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# --- JWT 签名密钥 ---
# 必须替换为随机值，至少 32 字节。生成方式（任选其一）：
#   openssl rand -hex 32
#   head -c 32 /dev/urandom | xxd -p
# 请勿使用示例值或任何提交进仓库的值：HS256 的密钥即签名能力，
# 一旦泄漏，任何人都能伪造出 ADMIN 身份的 token。
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# --- 管理员账号 ---
ADMIN_USERNAME=admin
# 优先使用下面的 BCrypt 哈希，配了它就会忽略 ADMIN_PASSWORD。
# 生成哈希（任选其一，Spring Security 的 BCryptPasswordEncoder 兼容 $2a/$2b/$2y 前缀）：
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'        # apache2-utils
#   python -c "import bcrypt;print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(10)).decode())"
# 注意：哈希里的 $ 在 docker-compose 的 .env 中会被当作变量插值，
# 若报错请把单个 $ 写成 $$（compose 的转义写法）。
ADMIN_PASSWORD_HASH=
# 明文密码：仅用于尚未迁移的环境，启动时会打 WARN 提醒
ADMIN_PASSWORD=change-this-admin-password

# --- 支付平台回调 HMAC 密钥（至少16位）---
PAYMENT_CALLBACK_SECRET=change-this-payment-callback-secret

# --- 微信支付配置（可选）---
WECHAT_MCH_ID=your-mch-id
WECHAT_API_KEY=your-api-key

# --- 支付宝配置（可选）---
ALIPAY_APP_ID=your-app-id
ALIPAY_PRIVATE_KEY=your-private-key
